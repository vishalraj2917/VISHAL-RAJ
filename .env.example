# ============================================================
# AI Air Quality Prediction System — Environment Configuration
# ============================================================

# Environment: "development", "production", "testing"
ENVIRONMENT=production

# Logging: "DEBUG", "INFO", "WARNING", "ERROR"
LOG_LEVEL=INFO

# PostgreSQL Connection URL (Use external managed DB like Neon/Supabase in production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_air_quality

# JWT & Authentication Secret
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-secret-in-production
JWT_SECRET_KEY=replace-with-a-secure-random-32-byte-hex-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed CORS Origins (comma-separated for multiple origins e.g. https://your-app.vercel.app)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Swagger / OpenAPI Documentation Flag (Can be set to false in hardened production)
ENABLE_DOCS=true

# Frontend API Target (for Vite client deployment)
VITE_API_URL=http://127.0.0.1:8000

# External APIs & AI Provider Credentials (Optional)
AQI_API_KEY=
WEATHER_API_KEY=
AIR_QUALITY_API_KEY=
AI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
